        <mxCell id="ent" value="Enterprise Admin holds EVERY code.&lt;br&gt;Migration 0106 + trigger trPermission_GrantEnterpriseAdmin on dbo.Permission&lt;br&gt;grants any newly added code in the same statement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
