<mxCell id="b41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="prod-diagnostics.yml  (workflow_dispatch)&lt;br&gt;app log tail, IIS state, PROD env key names, disk + uptime, outage-monitor state&lt;br&gt;-&amp;gt; read-only look at SYAPP01 without RDP" vertex="1"><mxGeometry x="1760" y="140" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="b42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="Outside GitHub: ops/outage_monitor.py on Task Scheduler (docs/howto/outage-monitor.md); ngrok tunnel for the public URL; WinRM access recipe in docs/howto/winrm-prod-access.md; PROD env keys hand-maintained (scripts/env-sync.py)." vertex="1"><mxGeometry x="1400" y="270" width="720" height="110" as="geometry"/></mxCell>
