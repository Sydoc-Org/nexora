<mxCell id="t28" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="Gotchas worth saying out loud&lt;br&gt;- id 1216 exists in both Octo and MS02 on INT: every cache key, element id and URL carries the client code.&lt;br&gt;- dbo.Clients is read once at import; a new client row needs an app-pool recycle. Credentials come from env keys named in the row, never from the DB.&lt;br&gt;- StatConfig / SearchConfig / IndexFieldMappings are gone (migration 0075); ProcessSources + ProcessFieldMappings replaced them (0074).&lt;br&gt;- Sensitivity redaction happens in nx_lib/workitems/sensitivity.py for UI and API alike - never in templates." vertex="1"><mxGeometry x="40" y="660" width="2000" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 Tenancy and permissions" id="5_Tenancy_and_permissions"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;fontStyle=1;" value="Three axes of &#x27;who is this for&#x27; + how a permission is decided" vertex="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell>
