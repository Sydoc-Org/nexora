        <mxCell id="rank" value="Rank rule (0086): actor may assign profile P iff P.Rank &amp;lt;= actor.profile.Rank&lt;br&gt;Enterprise Admin 100 · Global Admin 90 · Supervisors 50 · everything else 10&lt;br&gt;assignable_profile_ids() in nx_lib/security.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
