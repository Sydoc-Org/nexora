<mxCell id="t38" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="Migrations run BEFORE the app pool stops, so a failing migration leaves the old code running. robocopy /MIR purges anything not in git - the build stamp is written after it for that reason, and env/ + var/ are excluded so secrets and logs survive. After the pool starts, the footer shows the new build stamp; /admin/status shows engine health. Then run scripts/env-sync.py by hand if the deploy touched an env key." vertex="1"><mxGeometry x="360" y="620" width="1760" height="140" as="geometry"/></mxCell>
<mxCell id="b39" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;dashed=1;spacingTop=2;" value="Side workflows" vertex="1"><mxGeometry x="1380" y="100" width="760" height="300" as="geometry"/></mxCell>
