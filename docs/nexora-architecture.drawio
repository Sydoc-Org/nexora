<mxCell id="b21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="sql-sync-check                 re-dumps INT DDL into sql/&amp;lt;Db&amp;gt;/ and blocks the commit on drift (escape: SQL_SYNC_SKIP=1)" vertex="1"><mxGeometry x="60" y="670" width="980" height="46" as="geometry"/></mxCell>
<mxCell id="b22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="reporting-help-sync            nudge: reporting-guide.md &amp;lt;-&amp;gt; _reporting_help.html (non-blocking)" vertex="1"><mxGeometry x="60" y="724" width="980" height="46" as="geometry"/></mxCell>
<mxCell id="b23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="branch-name-guard              refuses badly named branches" vertex="1"><mxGeometry x="60" y="778" width="980" height="46" as="geometry"/></mxCell>
<mxCell id="b24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36393d;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="pre-push (branch guard)        refuses any push whose HEAD is main - GitHub Free has no branch protection" vertex="1"><mxGeometry x="60" y="832" width="980" height="46" as="geometry"/></mxCell>
<mxCell id="b25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;dashed=1;spacingTop=2;" value="Rules that keep parallel sessions sane" vertex="1"><mxGeometry x="1100" y="360" width="1040" height="560" as="geometry"/></mxCell>
<mxCell id="t26" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="- Claim the migration number NNNN in the issue before writing it; two sessions picking the same number is the standard collision. Migrations are immutable once applied - undo with a new one.&lt;br&gt;&lt;br&gt;- Never hand-merge generated files (sql/&amp;lt;Db&amp;gt;/*.sql, translations/*.po, messages.pot) - regenerate them.&lt;br&gt;&lt;br&gt;- Docs are part of the change: CHANGELOG.md [Unreleased], touched docs/howto, CLAUDE.md pointers, in the same commit.&lt;br&gt;&lt;br&gt;- New top-level file the running app does not need -&amp;gt; add it to the robocopy exclude list in deploy.yml, or /MIR ships it to PROD.&lt;br&gt;&lt;br&gt;- Env keys: adding one to env/PROD.env.example does nothing on the server. Run scripts/env-sync.py and hand-edit PROD.env.&lt;br&gt;&lt;br&gt;- Release recipe (CONTRIBUTING.md): bump nx_lib/version.py + pyproject.toml, uv lock, fold [Unreleased] into a dated section, merge, tag.&lt;br&gt;&lt;br&gt;- Footer shows &#x27;nexora v&amp;lt;version&amp;gt; + build stamp (short SHA, UTC date)&#x27; - the stamp, not the version, tells you what PROD runs." vertex="1"><mxGeometry x="1120" y="390" width="1000" height="520" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 CI-CD pipeline (deploy.yml)" id="7_CI-CD_pipeline_(deploy.yml)"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;fontStyle=1;" value="CI/CD - .github/workflows/deploy.yml on a self-hosted runner (SYAPP01, D:\sydoc\tools\py)" vertex="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell>
<mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" value="PR -&amp;gt; test job. Push to main -&amp;gt; test job then deploy job. Cron 03:00 Mon-Fri + workflow_dispatch -&amp;gt; e2e tier. Docs-only pushes skip everything." vertex="1"><mxGeometry x="40" y="52" width="1600" height="24" as="geometry"/></mxCell>
