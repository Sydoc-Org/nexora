        <mxCell id="g_res" value="resolution — dbo.fnUserHasPermission / dbo.spGetUserPermissions agree, in this order" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="740" height="220" as="geometry"/></mxCell>
        <mxCell id="res0" value="1.  user override Effect = &#x27;D&#x27;   →  DENIED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="res1" value="2.  user override Effect = &#x27;A&#x27;   →  granted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="702" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="res2" value="3.  row in AccessProfilePermission for the user&#x27;s profile  →  granted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="744" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="res3" value="4.  otherwise  →  denied" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="786" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="cache" value="nx_lib/user_cache.py — TTL cache&lt;br&gt;_reload_user_permissions refreshes session[&#x27;permissions&#x27;] per request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="375" width="400" height="65" as="geometry"/></mxCell>
        <mxCell id="e_4 t10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;" edge="1" parent="1" source="override" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="guard" value="@require_permission(&#x27;code&#x27;)  ·  has_permission(&#x27;code&#x27;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="385" width="290" height="45" as="geometry"/></mxCell>
        <mxCell id="e_4 t11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;" edge="1" parent="1" source="cache" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rank" value="Rank rule (0086): actor may assign profile P iff P.Rank &amp;lt;= actor.profile.Rank&lt;br&gt;Enterprise Admin 100 · Global Admin 90 · Supervisors 50 · everything else 10&lt;br&gt;assignable_profile_ids() in nx_lib/security.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="e_4 t12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;" edge="1" parent="1" source="profile" target="rank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ent" value="Enterprise Admin holds EVERY code.&lt;br&gt;Migration 0106 + trigger trPermission_GrantEnterpriseAdmin on dbo.Permission&lt;br&gt;grants any newly added code in the same statement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="700" height="70" as="geometry"/></mxCell>
        <mxCell id="n_gram" value="&lt;b&gt;Code grammar&lt;/b&gt;  (PERMISSION_CODE_RE in nx_lib/security.py)&lt;br&gt;&lt;br&gt;&amp;lt;area&amp;gt;[.&amp;lt;object&amp;gt;[.&amp;lt;sub&amp;gt;]].&amp;lt;action&amp;gt;[.&amp;lt;scope&amp;gt;]&lt;br&gt;&lt;br&gt;areas: admin workitems dashboard reporting process tenant api jd&lt;br&gt;&amp;nbsp;&amp;nbsp;(tenant.&amp;lt;code&amp;gt; and process.&amp;lt;client&amp;gt; are two-segment areas)&lt;br&gt;actions: view add edit delete use run export schedule manage bypass import restart&lt;br&gt;scopes: org · all · pastdeadline  — no scope means own records&lt;br&gt;&lt;br&gt;&amp;lt;area&amp;gt;.view is the landing page and gates everything beneath it in the&lt;br&gt;admin grid — a &lt;i&gt;UI convention only&lt;/i&gt;; the server checks each code alone.&lt;br&gt;&lt;br&gt;Renamed by #238, applied by migration 0088. Detail: docs/design/permissions.md" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="740" height="215" as="geometry"/></mxCell>
        <mxCell id="n_pref" value="&lt;b&gt;UI preferences&lt;/b&gt; are allowlisted JSON in dbo.Users.ui_prefs&lt;br&gt;(nx_lib/ui_prefs.py), applied pre-paint in templates/_header.html,&lt;br&gt;edited on /appearance. &lt;b&gt;Never cache them in the session&lt;/b&gt; (#155)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="700" height="90" as="geometry"/></mxCell>
        <mxCell id="n_admin" value="&lt;b&gt;Admin surfaces&lt;/b&gt;&lt;br&gt;/admin/tenants/manage · /admin/clients · /admin/processes&lt;br&gt;Onboarding a customer — the ClientCode runtime-source vs&lt;br&gt;Organizations customer split: docs/howto/white-label.md" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="870" width="740" height="90" as="geometry"/></mxCell>
