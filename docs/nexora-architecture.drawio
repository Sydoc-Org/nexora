<mxCell id="t32" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="Admin edits therefore land within 30 s without re-login. Sessions can be revoked centrally (/admin/sessions) because _enforce_active_session checks dbo.ActiveSessions. ui_prefs ride the same cache and are never stored in the session (#155). The external API never touches any of this: api_auth.py resolves the Bearer key to a client scope." vertex="1"><mxGeometry x="60" y="700" width="2060" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 Git workflow and local gates" id="6_Git_workflow_and_local_gates"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;whiteSpace=wrap;fontStyle=1;" value="Git workflow" vertex="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell>
<mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" value="Short-lived topic branches from main; main is deploy-on-merge; a release is a tag, not a branch." vertex="1"><mxGeometry x="40" y="52" width="1600" height="24" as="geometry"/></mxCell>
<mxCell id="b3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;fontStyle=1;" value="main   - always deployable; every merge deploys to PROD; version moves only on a release tag (v3.2.x)" vertex="1"><mxGeometry x="40" y="130" width="2100" height="50" as="geometry"/></mxCell>
<mxCell id="b4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" value="feat/341-workitems-include-fields&lt;br&gt;&amp;lt;type&amp;gt;/&amp;lt;issue&amp;gt;-&amp;lt;slug&amp;gt;, Conventional-Commit type" vertex="1"><mxGeometry x="120" y="240" width="420" height="70" as="geometry"/></mxCell>
