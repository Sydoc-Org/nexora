# Backlog-history collector — only the creds this script needs.
# Copy to .env next to backlog_history.py and fill in. Variable names match
# the main nexora env files, so values can be copied over 1:1.

# SQL Server (Octo runtime + Statistics DB share one server/login)
DB_SERVER_PRD=
DB_UID=
DB_PWD=
DB_OCTO_RUNTIME=
DB_STATISTICS=

# MS02 Azure Postgres runtime — OPTIONAL: leave empty to skip the MS02 source
MS02_DB_SERVER_PRD=
MS02_DB_PORT=5432
MS02_DB_OCTO_RUNTIME=
MS02_DB_UID=
MS02_DB_PWD=
MS02_DB_SSLMODE=require

# Ticket-on-failure via Microsoft Graph mail (same ROPC creds as nexora) -
# OPTIONAL: leave TICKET_TO empty to disable ticketing (failures still log)
TICKET_TO=support.helpdesk@sydoc.ch
TICKET_COOLDOWN_HOURS=6
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USERNAME=
GRAPH_PASSWORD=
