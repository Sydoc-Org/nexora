# env/TEST.env.example — copy to env/TEST.env, then fill in real values.
#
# TEST drives the pytest suite against the NEXORA_TEST database. Reset
# the DB before each test session with .\scripts\test-db-reset.ps1.
# Real credentials live only in env/TEST.env (gitignored) and are also
# provisioned on the CI runner at C:\sydoc\runner-secrets\TEST.env so
# the GitHub Actions test job can copy them into the workspace.
#
# ENVIRONMENT is set here so the loader chain works whether or not the
# parent process sets it explicitly (the CI job does set it as a step
# env var; local pytest runs usually do not).

ENVIRONMENT=TEST

FLASK_SECRET_KEY=replace-me-with-a-random-32-char-hex-string

DB_SERVER_PRD=replace-me.example.internal
DB_UID=nexora_user
DB_PWD=replace-me
DB_NEXORA=NEXORA_TEST
DB_STATISTICS=sydoc_stat_TEST
DB_OCTO_RUNTIME=OctoDB_TEST
DB_GENERALI=Generali_TEST

GRAPH_TENANT_ID=replace-me-uuid
GRAPH_CLIENT_ID=replace-me-uuid
GRAPH_USERNAME=replace-me@example.com
GRAPH_PASSWORD=replace-me
GRAPH_CLIENT_SECRET=replace-me

OCTO_CLIENT_SECRET=replace-me
OCTO_CLIENT_ID=replace-me
OCTO_GRANT_TYPE=client_credentials
OCTO_DOMAIN=replace-me.example.internal

BEXIO_PAT=replace-me
