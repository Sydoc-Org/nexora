# env/INT.env.example — copy to env/INT.env, then fill in real values.
#
# INT is the integration environment used for local dev and for the
# self-hosted dev instance on SYAPP01. DB targets are usually the *_INT
# replicas. Real credentials live only in env/INT.env (gitignored).

FLASK_SECRET_KEY=replace-me-with-a-random-32-char-hex-string

DB_UID=nexora_user
DB_PWD=replace-me
DB_SERVER_PRD=replace-me.example.internal
DB_NEXORA=NexoraDB_INT
DB_STATISTICS=sydoc_stat_INT
DB_OCTO_RUNTIME=OctoDB_INT
# ODBC driver for SQL Server engines (#193 finding 16). Default "SQL Server"
# is the legacy unencrypted driver (kept as-is until the modern driver is
# confirmed installed on this box). Set to "ODBC Driver 17 for SQL Server"
# (or 18) to switch drivers AND turn on Encrypt=yes/TrustServerCertificate=yes.
DB_ODBC_DRIVER=SQL Server
# Dedicated read-only login (db_datareader only) for the Reporting SQL sandbox.
# Provisioned by the owner; leave unset to disable the live-SQL source.
DB_REPORTING_RO_USER=reporting_ro
DB_REPORTING_RO_PWD=replace-me
# Dedicated read-only login (db_datareader only) for the SQL sandbox's Octopus
# target. Separate from the Statistics RO login above; leave unset to disable
# the Octopus SQL target.
DB_REPORTING_OCTO_RO_USER=reporting_octo_ro
DB_REPORTING_OCTO_RO_PWD=replace-me

GRAPH_TENANT_ID=replace-me-uuid
GRAPH_CLIENT_ID=replace-me-uuid
GRAPH_CLIENT_SECRET=replace-me
GRAPH_USERNAME=replace-me@example.com
GRAPH_PASSWORD=replace-me

OCTO_DOMAIN=replace-me.example.internal
OCTO_CLIENT_SECRET=replace-me
OCTO_CLIENT_ID=replace-me
OCTO_GRANT_TYPE=client_credentials

# MS02 client — Azure Postgres runtime DB + second Octo endpoint.
# Mirrors the default DB_*/OCTO_* set with an MS02_ prefix. Leave blank to
# disable MS02 (engine_ms02_pg degrades to None and the feature stays dormant).
MS02_DB_SERVER_PRD=your-ms02-host.postgres.database.azure.com
MS02_DB_OCTO_RUNTIME=ms02_octo_db
MS02_DB_UID=ms02_app
MS02_DB_PWD=
MS02_DB_PORT=5432
MS02_OCTO_DOMAIN=ms02.octo.example
MS02_CLIENT_ID=
MS02_CLIENT_SECRET=
MS02_GRANT_TYPE=client_credentials
# TLS: default 'require' encrypts but does not verify the server cert. To close
# the MITM gap, set verify-full + point MS02_DB_SSLROOTCERT at an Azure root-CA
# bundle present on the host.
MS02_DB_SSLMODE=require
MS02_DB_SSLROOTCERT=
# MS02 dashboard-statistics DB (separate Postgres DB on the same host).
# Defaults reuse the MS02 runtime host/login with dbname=Praesidialdepartement_BS.
MS02_STATS_DB_HOST=
MS02_STATS_DB_NAME=Praesidialdepartement_BS
MS02_STATS_DB_USER=
MS02_STATS_DB_PWD=
MS02_STATS_DB_PORT=5432
# MS02 doc-field index DB (separate Postgres DB on the same host).
# Defaults reuse the MS02 runtime host/login; only the dbname differs and has
# NO default -- set MS02_DOCFIELDS_DB_NAME to enable MS02 doc-field search.
MS02_DOCFIELDS_DB_HOST=
MS02_DOCFIELDS_DB_NAME=
MS02_DOCFIELDS_DB_USER=
MS02_DOCFIELDS_DB_PWD=
MS02_DOCFIELDS_DB_PORT=5432

BEXIO_PAT=replace-me

# --- Outage detection (ops/outage_monitor.py, Task Scheduler) ---
# Support inbox that outage/recovery tickets are mailed to. Leave unset to
# probe + log without ever sending mail (the right setting for a dev box).
SUPPORT_MAIL=
# Public URL the monitor GETs to prove IIS + the app pool are alive.
OUTAGE_SITE_URL=https://nexora.sydoc.ch/nexora/
# Monitor-only key from dbo.ApiKeys; probes the external API's auth path.
# Unset -> the api:key probe skips itself (api:v1 still runs).
OUTAGE_API_KEY=


# --- Reporting AI assistant (Phase 1: NL -> SQL) ---
# AI_PROVIDER selects the model backend. Leave as "none" to disable the assistant
# (the /api/reporting/ai/ask route then returns 503, like an unconfigured RO source).
AI_PROVIDER=none
AI_MODEL=claude-sonnet-4-6
# Anthropic (AI_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# Azure OpenAI (AI_PROVIDER=azure):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Per-user/day cap on AI asks (cost/abuse control). 0 = unlimited (disabled).
AI_DAILY_LIMIT=0
# Per-model-call HTTP read timeout in seconds. Reasoning deployments (GPT-5
# family) routinely need more than 30s on a hard question.
AI_TIMEOUT_S=120
# Wall-clock ceiling for one agentic (chat) run, checked between turns.
AI_AGENT_BUDGET_S=180
