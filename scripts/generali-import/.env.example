# .env for the Generali CSV import scripts (csvToSql.ps1, getGeneraliCsvAttachment.ps1).
# Copy this file to ".env", fill in the real values, then deploy ".env" next to the
# scripts on the import host:  \\prdimpexp01\d$\sydoc\scripts\generali\.env
#
# Format: KEY=value, one per line. No quotes, no spaces around "=", and NO inline
# comments (load_from_dot_env folds a trailing "# ..." into the value). Full-line
# comments (a line that starts with "#") are ignored.

# --- Microsoft Graph (resource-owner password grant; send mail + read the mailbox) ---
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret
USERNAME=service-account@example.com
PASSWORD=service-account-password
GRANT_TYPE=password
SCOPE=https://graph.microsoft.com/.default

# --- Generali mailbox folder ids (Graph mailFolders ids) ---
GENERALI_MAILBOX_ID=mailfolder-id
GENERALI_MAILBOX_POSTEINGANG_ID=posteingang-childfolder-id
GENERALI_MAILBOX_GELOESCHT_ID=geloescht-childfolder-id

# --- SQL target (reportjob + CSVImportLog) ---
# DATABASE is passed to Invoke-Sqlcmd. SERVERINSTANCE is kept for reference; the
# scripts currently target INTSQL01 then PRDSQL01 directly (see $serverInstances).
DATABASE=YourDatabaseName
SERVERINSTANCE=INTSQL01
