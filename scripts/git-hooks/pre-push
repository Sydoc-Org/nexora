#!/usr/bin/env bash
# Pre-push hook for nexora.
#   1. Refuse pushes to branches not named 'main' or 'feature/<x.y.z>'.
#   2. Run the full pytest suite before allowing the push.
# Bypass either gate with: git push --no-verify
set -e

allowed='^(main|feature/[0-9]+\.[0-9]+\.[0-9]+)$'

# --- 1. Branch-name guard ---
while read -r local_ref local_oid remote_ref remote_oid; do
    # Skip deletions (local_oid is all zeros)
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Only check branch pushes
    case "$remote_ref" in
        refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
        *) continue ;;
    esac

    if ! echo "$branch" | grep -Eq "$allowed"; then
        echo "[pre-push] refused: branch '$branch' must be 'main' or match 'feature/<x.y.z>' (e.g. feature/2.5.60)." >&2
        echo "[pre-push] rename with: git branch -m feature/<x.y.z>" >&2
        echo "[pre-push] bypass with: git push --no-verify" >&2
        exit 1
    fi
done

# --- 2. Test suite (same command as CI) ---
repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if [ -x "venv/Scripts/python.exe" ]; then
    PY="venv/Scripts/python.exe"
elif [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"
else
    PY="python"
fi

echo "[pre-push] Running pytest..."
exec "$PY" -m pytest tests -q
