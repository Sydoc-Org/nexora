#!/usr/bin/env bash
# Block pushing any branch whose name isn't 'main' or 'feature/<x.y.z>'.
# Skip with: git push --no-verify
set -e

allowed='^(main|feature/[0-9]+\.[0-9]+\.[0-9]+)$'

while read -r local_ref local_oid remote_ref remote_oid; do
    # Skip deletions (local_oid is all zeros)
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Only check branch pushes
    case "$remote_ref" in
        refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
        *) continue ;;
    esac

    if ! echo "$branch" | grep -Eq "$allowed"; then
        echo "[pre-push] refused: branch '$branch' must be 'main' or match 'feature/<x.y.z>' (e.g. feature/2.5.60)." >&2
        echo "[pre-push] rename with: git branch -m feature/<x.y.z>" >&2
        echo "[pre-push] bypass with: git push --no-verify" >&2
        exit 1
    fi
done
