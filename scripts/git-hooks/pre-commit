#!/usr/bin/env bash
# Before each commit:
#   1. Apply any pending sql/_migrations/<Db>/*.sql to INT (block on SQL errors).
#   2. Regenerate sql/<Db>/ from INT and block if it drifted.
# Skip both with: SQL_SYNC_SKIP=1 git commit ...   or   git commit --no-verify
set -e

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if [ -x "venv/Scripts/python.exe" ]; then
    PY="venv/Scripts/python.exe"
elif [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"
else
    PY="python"
fi

echo "[pre-commit] applying any pending migrations to INT..."
"$PY" scripts/db-migrate.py --env INT

echo "[pre-commit] syncing sql/ from INT..."
"$PY" sql/sync-from-db.py --check
