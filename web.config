<configuration>
    <!--
      PROD hosting contract (SYAPP01). IIS owns TLS/port binding and the app
      pool lifecycle; HttpPlatformHandler starts ONE waitress process from the
      prod interpreter and reverse-proxies every request to it on a loopback
      port it picks (%HTTP_PLATFORM_PORT%). Nothing else is configured in IIS
      Manager. Setup, knobs and troubleshooting: docs/howto/iis.md.
      Guarded by tests/unit/test_iis_hosting.py.
    -->
    <system.webServer>
        <security>
            <requestFiltering>
                <verbs>
                    <add verb="OPTIONS" allowed="false" />
                </verbs>
            </requestFiltering>
        </security>

        <handlers>
            <add name="nexora-waitress"
                 path="*"
                 verb="*"
                 modules="httpPlatformHandler"
                 resourceType="Unspecified"
                 requireAccess="Script" />
        </handlers>

        <!--
          - listen on 127.0.0.1 only: IIS is the sole client, LAN can't bypass it.
          - threads=32 matches the SQLAlchemy pools (10 + 20 overflow per engine).
          - connection-limit=1000: keep-alive channels from ~500 browsers must not
            hit waitress's default ceiling of 100.
          - url-scheme=https: TLS terminates at the ngrok edge, so the request
            waitress sees is always plain HTTP. Telling it "https" keeps Talisman's
            force_https from redirect-looping and url_for(_external=True) correct.
          - trusted-proxy 127.0.0.1 + x-forwarded-for: waitress >= 2 STRIPS
            X-Forwarded-* from untrusted peers; IIS is the peer, so trust it or the
            CSV log and the rate limiter see nothing but 127.0.0.1.
          - The /nexora prefix arrives untouched; nx_lib.middleware.PrefixMiddleware
            strips it (unchanged from the FastCGI setup). No URL Rewrite rules: a
            rewrite to nx_main.py would reach waitress as a 404.
        -->
        <httpPlatform processPath="D:\sydoc\tools\py\python.exe"
                      arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% --threads=32 --connection-limit=1000 --url-scheme=https --trusted-proxy=127.0.0.1 --trusted-proxy-headers=x-forwarded-for --ident=nexora nx_main:app"
                      startupTimeLimit="60"
                      startupRetryCount="3"
                      requestTimeout="00:02:00"
                      stdoutLogEnabled="true"
                      stdoutLogFile="D:\sydoc\nexora\var\logs\system\waitress-stdout">
            <environmentVariables>
                <environmentVariable name="ENVIRONMENT" value="PROD" />
                <environmentVariable name="PYTHONPATH" value="D:\sydoc\nexora" />
                <environmentVariable name="PYTHONUNBUFFERED" value="1" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>
