<configuration>
<system.webServer>
        
        <rewrite>
            <rules>
                <rule name="StaticFiles" stopProcessing="true">
                    <match url="^static/.*" />
                    <action type="None" />
                </rule>
                
                <rule name="FlaskPy" stopProcessing="true">
                    <match url=".*" />
                    <action type="Rewrite" url="app.py" /> </rule>
            </rules>
        </rewrite>

        <handlers>
            <remove name="PythonHandler" />
            <add name="PythonHandler" 
                 path="*" 
                 verb="*" 
                 modules="FastCgiModule" 
                 scriptProcessor="D:\sydoc\app\Python\python.exe|D:\sydoc\app\Python\Lib\site-packages\wfastcgi.py" 
                 resourceType="Unspecified" 
                 requireAccess="Script" 
                 preCondition="integratedMode" />
        </handlers>

    </system.webServer>
    <appSettings>
       <add key="PYTHONPATH" value="D:\sydoc\app\sydocportal\Kundenportal-Sydoc" />
       <add key="WSGI_HANDLER" value="app.app" />
       <add key="WSGI_LOG" value="D:\sydoc\app\sydocportal\Kundenportal-Sydoc\logs\app.log" />
    </appSettings>
</configuration>