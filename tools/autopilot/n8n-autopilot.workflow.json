    },
    "run-exec": { "main": [ [ { "node": "cost-add-exec", "type": "main", "index": 0 } ] ] },
    "cost-add-exec": { "main": [ [ { "node": "verify-exec", "type": "main", "index": 0 } ] ] },
    "verify-exec": { "main": [ [ { "node": "exec-ok?", "type": "main", "index": 0 } ] ] },
    "exec-ok?": {
      "main": [
        [ { "node": "comment-built", "type": "main", "index": 0 } ],
        [ { "node": "recover", "type": "main", "index": 0 } ]
      ]
    },
    "comment-built": { "main": [ [ { "node": "notify-built", "type": "main", "index": 0 } ] ] },
    "notify-built": { "main": [ [ { "node": "continue-collector", "type": "main", "index": 0 } ] ] },
    "recover": { "main": [ [ { "node": "route-recovery", "type": "main", "index": 0 } ] ] },
    "route-recovery": {
      "main": [
        [ { "node": "comment-built-recovered", "type": "main", "index": 0 } ],
        [ { "node": "mark-blocked", "type": "main", "index": 0 } ],
        [ { "node": "notify-pause", "type": "main", "index": 0 } ],
        [ { "node": "notify-pause", "type": "main", "index": 0 } ]
      ]
    },
    "comment-built-recovered": { "main": [ [ { "node": "notify-recovered", "type": "main", "index": 0 } ] ] },
    "notify-recovered": { "main": [ [ { "node": "continue-collector", "type": "main", "index": 0 } ] ] },
    "mark-blocked": { "main": [ [ { "node": "notify-skip", "type": "main", "index": 0 } ] ] },
    "notify-skip": { "main": [ [ { "node": "continue-collector", "type": "main", "index": 0 } ] ] },
    "continue-collector": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "notify-pause": { "main": [ [ { "node": "release-lock-halt", "type": "main", "index": 0 } ] ] },
    "release-lock-halt": { "main": [ [ { "node": "STOP", "type": "main", "index": 0 } ] ] }
  }
}
