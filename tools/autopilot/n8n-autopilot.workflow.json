{
  "name": "autopilot",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 7200,
    "saveExecutionProgress": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "meta": {},
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 2 } ] }
      },
      "id": "trg-schedule",
      "name": "Every 2 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 480]
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\fetch-queue.ps1"
      },
      "id": "cmd-fetch",
      "name": "fetch-queue",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 480]
    },
    {
      "parameters": {
        "jsCode": "const q = JSON.parse($input.first().json.stdout || '[]');\nreturn [{ json: { queue: q, count: q.length } }];"
      },
      "id": "code-parse",
      "name": "parse-queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-havework",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-havework",
      "name": "have-work?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 480]
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\lock.ps1 -Action acquire"
      },
      "id": "cmd-acquire",
      "name": "acquire-lock",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [880, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-gotlock",
              "leftValue": "={{ JSON.parse($json.stdout).status }}",
              "rightValue": "ACQUIRED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-gotlock",
      "name": "got-lock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 480]
    },
    {
      "parameters": {
        "jsCode": "const q = $('parse-queue').first().json.queue;\nreturn q.map(i => ({ json: i }));"
      },
      "id": "code-split",
      "name": "split-to-items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 480]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-items",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1540, 480]
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\lock.ps1 -Action release"
      },
      "id": "cmd-release-done",
      "name": "release-lock-done",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1540, 220]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "=🏁 autopilot run complete — queue drained.{{ (() => { try { const p = JSON.parse($('push-branch').item.json.stdout); if (!p || p.status === 'disabled') return ''; if (p.pushed) return ' Pushed ' + p.branch + ' to origin (e2e gate passed).'; return ' ⚠ NOT pushed — ' + p.reason; } catch (e) { return ''; } })() }}",
        "additionalFields": {}
      },
      "id": "tg-summary",
      "name": "notify-summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1760, 220],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "autopilot-telegram" } }
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -Command \"if (git -C C:\\dev\\nexora status --porcelain) { 'DIRTY' } else { 'CLEAN' }\""
      },
      "id": "cmd-preflight",
      "name": "preflight",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1760, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-clean",
              "leftValue": "={{ $json.stdout.trim() }}",
              "rightValue": "CLEAN",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-clean",
      "name": "clean?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 480]
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\baseline.ps1"
      },
      "id": "cmd-baseline",
      "name": "baseline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2200, 480]
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\run-phase.ps1 -Phase plan -IssueNumber {{ $('Loop Over Items').item.json.number }}"
      },
      "id": "cmd-runplan",
      "name": "run-plan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2420, 480]
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\probe-state.ps1 -Phase plan -BeforeSha {{ JSON.parse($('baseline').item.json.stdout).sha }}"
      },
      "id": "cmd-verifyplan",
      "name": "verify-plan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2640, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-planok",
              "leftValue": "={{ JSON.parse($json.stdout).ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-planok",
      "name": "plan-ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2860, 480]
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\run-phase.ps1 -Phase execute"
      },
      "id": "cmd-runexec",
      "name": "run-exec",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3080, 480]
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\probe-state.ps1 -Phase execute -BeforeSha {{ JSON.parse($('verify-plan').item.json.stdout).headSha }}"
      },
      "id": "cmd-verifyexec",
      "name": "verify-exec",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3300, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-execok",
              "leftValue": "={{ JSON.parse($json.stdout).ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-execok",
      "name": "exec-ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3520, 480]
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\comment-result.ps1 -IssueNumber {{ $('Loop Over Items').item.json.number }} -Status built"
      },
      "id": "cmd-commentbuilt",
      "name": "comment-built",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3740, 480]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "=✅ #{{ $('Loop Over Items').item.json.number }} built — commit pending push",
        "additionalFields": {}
      },
      "id": "tg-built",
      "name": "notify-built",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3960, 480],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "autopilot-telegram" } }
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\comment-result.ps1 -IssueNumber {{ $('Loop Over Items').item.json.number }} -Status blocked"
      },
      "id": "cmd-markblocked",
      "name": "mark-blocked",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2860, 760]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "=⛔ loop HALTED at #{{ $('Loop Over Items').item.json.number }} — {{ (() => { try { return JSON.parse($('mark-blocked').item.json.stdout).reason || 'a check failed (see n8n execution)'; } catch (e) { return 'a check failed (see n8n execution)'; } })() }}",
        "additionalFields": {}
      },
      "id": "tg-halt",
      "name": "notify-halt",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3080, 760],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "autopilot-telegram" } }
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\lock.ps1 -Action release"
      },
      "id": "cmd-release-halt",
      "name": "release-lock-halt",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3300, 760]
    },
    {
      "parameters": {},
      "id": "noop-stop",
      "name": "STOP",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3520, 760]
    },
    {
      "parameters": {
        "command": "=pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\solve-blocked.ps1 -IssueNumber {{ $('Loop Over Items').item.json.number }}"
      },
      "id": "cmd-solveblocked",
      "name": "solve-blocked",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2860, 1000]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-fixok",
              "leftValue": "={{ JSON.parse($json.stdout).ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-fixok",
      "name": "fix-ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3300, 1000]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "=🛠️ #{{ $('Loop Over Items').item.json.number }} recovered by the autopilot fixer.{{ (() => { try { const v = JSON.parse($('solve-blocked').item.json.stdout); return ' Commit ' + v.sha + (v.stashed ? '. ⚠ pre-existing WIP was stashed before fixing — run: git stash list / git stash pop to recover.' : '.'); } catch (e) { return ''; } })() }}",
        "additionalFields": {}
      },
      "id": "tg-fixed",
      "name": "notify-fixed",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3520, 1000],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CRED_ID", "name": "autopilot-telegram" } }
    },
    {
      "parameters": {
        "command": "pwsh -NoProfile -File C:\\dev\\nexora\\tools\\autopilot\\push-branch.ps1"
      },
      "id": "cmd-pushbranch",
      "name": "push-branch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1320, 220]
    }
  ],
  "connections": {
    "Every 2 min": { "main": [ [ { "node": "fetch-queue", "type": "main", "index": 0 } ] ] },
    "fetch-queue": { "main": [ [ { "node": "parse-queue", "type": "main", "index": 0 } ] ] },
    "parse-queue": { "main": [ [ { "node": "have-work?", "type": "main", "index": 0 } ] ] },
    "have-work?": { "main": [ [ { "node": "acquire-lock", "type": "main", "index": 0 } ], [] ] },
    "acquire-lock": { "main": [ [ { "node": "got-lock?", "type": "main", "index": 0 } ] ] },
    "got-lock?": { "main": [ [ { "node": "split-to-items", "type": "main", "index": 0 } ], [] ] },
    "split-to-items": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "Loop Over Items": {
      "main": [
        [ { "node": "push-branch", "type": "main", "index": 0 } ],
        [ { "node": "preflight", "type": "main", "index": 0 } ]
      ]
    },
    "push-branch": { "main": [ [ { "node": "release-lock-done", "type": "main", "index": 0 } ] ] },
    "release-lock-done": { "main": [ [ { "node": "notify-summary", "type": "main", "index": 0 } ] ] },
    "preflight": { "main": [ [ { "node": "clean?", "type": "main", "index": 0 } ] ] },
    "clean?": {
      "main": [
        [ { "node": "baseline", "type": "main", "index": 0 } ],
        [ { "node": "solve-blocked", "type": "main", "index": 0 } ]
      ]
    },
    "baseline": { "main": [ [ { "node": "run-plan", "type": "main", "index": 0 } ] ] },
    "run-plan": { "main": [ [ { "node": "verify-plan", "type": "main", "index": 0 } ] ] },
    "verify-plan": { "main": [ [ { "node": "plan-ok?", "type": "main", "index": 0 } ] ] },
    "plan-ok?": {
      "main": [
        [ { "node": "run-exec", "type": "main", "index": 0 } ],
        [ { "node": "solve-blocked", "type": "main", "index": 0 } ]
      ]
    },
    "run-exec": { "main": [ [ { "node": "verify-exec", "type": "main", "index": 0 } ] ] },
    "verify-exec": { "main": [ [ { "node": "exec-ok?", "type": "main", "index": 0 } ] ] },
    "exec-ok?": {
      "main": [
        [ { "node": "comment-built", "type": "main", "index": 0 } ],
        [ { "node": "solve-blocked", "type": "main", "index": 0 } ]
      ]
    },
    "comment-built": { "main": [ [ { "node": "notify-built", "type": "main", "index": 0 } ] ] },
    "notify-built": { "main": [ [ { "node": "Loop Over Items", "type": "main", "index": 0 } ] ] },
    "mark-blocked": { "main": [ [ { "node": "notify-halt", "type": "main", "index": 0 } ] ] },
    "notify-halt": { "main": [ [ { "node": "release-lock-halt", "type": "main", "index": 0 } ] ] },
    "release-lock-halt": { "main": [ [ { "node": "STOP", "type": "main", "index": 0 } ] ] },
    "solve-blocked": { "main": [ [ { "node": "fix-ok?", "type": "main", "index": 0 } ] ] },
    "fix-ok?": {
      "main": [
        [ { "node": "notify-fixed", "type": "main", "index": 0 } ],
        [ { "node": "mark-blocked", "type": "main", "index": 0 } ]
      ]
    },
    "notify-fixed": { "main": [ [ { "node": "comment-built", "type": "main", "index": 0 } ] ] }
  }
}
