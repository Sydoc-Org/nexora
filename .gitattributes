# Normalize line endings: store as LF in the repo, check out as the
# platform's native line ending (CRLF on Windows). Silences the
# "LF will be replaced by CRLF" warning by making the rule explicit
# instead of letting git autocrlf guess per-file.
* text=auto

# Force LF for files where CRLF would break things.
*.sh                  text eol=lf
*.py                  text eol=lf
*.yml                 text eol=lf
*.yaml                text eol=lf
scripts/git-hooks/*   text eol=lf
.git/hooks/*          text eol=lf
# Docs and message catalogs: the mixed-line-ending pre-commit hook enforces LF,
# and pybabel emits CRLF on Windows — pin these to LF so a fresh checkout matches
# the hook (otherwise a first push of a new branch trips the full-range scan).
*.md                  text eol=lf
*.po                  text eol=lf
*.pot                 text eol=lf

# Treat these as binary so git never tries to normalize them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.mo   binary
