# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.{html,jinja,j2}]
indent_size = 2

[Makefile]
indent_style = tab
