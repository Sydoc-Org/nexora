#: nx_lib/controlling.py:105 templates/js/_controlling_js.html:135
msgid "documents"
msgstr "documenti"

#: nx_lib/controlling.py:174 templates/js/_controlling_js.html:135
msgid "dossiers"
msgstr "dossier"

#: nx_lib/controlling.py:187
msgid "via Xpert"
msgstr "tramite Xpert"

#: nx_lib/controlling.py:219 templates/js/_controlling_js.html:135
msgid "pieces"
msgstr "pezzi"

#: nx_lib/controlling.py:247
msgid ""
"BPS has fewer hours than the controlling workbook for this month: the "
"bookings were never in the timetool, so cost and margin are too "
"favourable."
msgstr ""
"BPS ha meno ore del file di controlling per questo mese: le registrazioni"
" non sono mai state nel timetool, quindi costi e margine sono troppo "
"favorevoli."

#: nx_lib/controlling.py:560
msgid "Unknown rate kind."
msgstr "Tipo di tariffa sconosciuto."

#: nx_lib/controlling.py:562 nx_lib/controlling.py:604
msgid "Unknown stream."
msgstr "Flusso cliente sconosciuto."

#: nx_lib/controlling.py:569
msgid "The rate must be a number."
msgstr "La tariffa deve essere un numero."

#: nx_lib/controlling.py:571
msgid "The rate must be a positive number."
msgstr "La tariffa deve essere un numero positivo."

#: nx_lib/controlling.py:581 nx_lib/controlling.py:612
msgid "A month must read YYYY-MM."
msgstr "Un mese deve essere nel formato AAAA-MM."

#: nx_lib/controlling.py:583
msgid "'Valid to' is before 'valid from'."
msgstr "«Valido fino a» precede «valido da»."

#: nx_lib/controlling.py:607
msgid "Name the cost."
msgstr "Indica il nome del costo."

#: nx_lib/controlling.py:619
msgid "The amount must be a number."
msgstr "L'importo deve essere un numero."

#: nx_lib/controlling.py:621
msgid "The amount must not be 0."
msgstr "L'importo non può essere 0."

#: nx_lib/finance.py:259
msgid ""
"EM_Invoice is still edited after a month ends: a re-exported document "
"moves to the month of its new export date. Close the month once it is "
"invoiced so its figures stay as billed. Only the Opex and e-mail channels"
" are billed."
msgstr ""
"EM_Invoice viene ancora modificato dopo la fine del mese: un documento "
"riesportato passa al mese della sua nuova data di esportazione. Chiudere "
"il mese una volta fatturato, così le cifre restano come fatturate. Sono "
"fatturati solo i canali Opex ed e-mail."

#: nx_lib/finance.py:266 nx_lib/finance.py:300 nx_lib/finance.py:324
#: nx_lib/finance.py:345 nx_lib/finance.py:470
msgid "by export date"
msgstr "per data di esportazione"

#: nx_lib/finance.py:268 templates/generali_documents.html:92
#: templates/generali_documents.html:155 templates/generali_documents.html:239
msgid "Channel"
msgstr "Canale"

#: nx_lib/finance.py:278
msgid ""
"Counted by upload date, whatever the document date: that is the set the "
"invoice bills. Rows without a workitem that repeat a barcode (74 in "
"August 2026) are counted, as the workbook counts them."
msgstr ""
"Conteggiato per data di caricamento, indipendentemente dalla data del "
"documento: è l'insieme fatturato. Le righe senza workitem che ripetono un"
" codice a barre (74 ad agosto 2026) vengono contate, come nella cartella "
"di lavoro."

#: nx_lib/finance.py:284
msgid "by upload date"
msgstr "per data di caricamento"

#: nx_lib/finance.py:295
msgid ""
"The export date of this source is text, so the month is matched on its "
"'.MM.yyyy' part."
msgstr ""
"La data di esportazione di questa fonte è testo, quindi il mese viene "
"individuato dalla parte '.MM.yyyy'."

