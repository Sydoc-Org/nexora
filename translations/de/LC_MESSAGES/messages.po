msgstr "Workitem-ID"

#: nx_lib/views/auth.py:117
msgid "Your nexora account is ready"
msgstr "Ihr nexora-Konto ist bereit"

#: nx_lib/views/auth.py:119
msgid ""
"An account has been created for you on nexora. Choose your own password "
"by clicking the button below. You will then be asked to set up two-factor"
" authentication."
msgstr ""
"Für Sie wurde ein Konto in nexora erstellt. Wählen Sie über die "
"Schaltfläche unten Ihr eigenes Passwort. Anschließend werden Sie zur "
"Einrichtung der Zwei-Faktor-Authentifizierung aufgefordert."

#: nx_lib/views/auth.py:123
msgid "This link is valid for 7 days."
msgstr "Dieser Link ist 7 Tage gültig."

#: nx_lib/views/auth.py:124
msgid "Set Your Password"
msgstr "Legen Sie Ihr Passwort fest"

#: nx_lib/views/auth.py:126
msgid "nexora Password Reset Request"
msgstr "nexora Anfrage zum Zurücksetzen des Passworts"

#: nx_lib/views/auth.py:128
msgid ""
"We received a request to reset the password for your account. You can "
"reset your password by clicking the button below."
msgstr ""
"Wir haben eine Anfrage erhalten, das Passwort für Ihr Konto "
"zurückzusetzen. Sie können Ihr Passwort zurücksetzen, indem Sie auf die "
"Schaltfläche unten klicken."

#: nx_lib/views/auth.py:132
msgid ""
"If you did not request a password reset, please ignore this email. This "
"link is valid for 15 minutes."
msgstr ""
"Falls Sie keine Passwortzurücksetzung angefordert haben, ignorieren Sie "
"diese E-Mail bitte. Dieser Link ist 15 Minuten gültig."

#: nx_lib/views/auth.py:135
msgid "Reset Your Password"
msgstr "Setzen Sie Ihr Passwort zurück"

#: nx_lib/views/auth.py:186
msgid "Hello,"
msgstr "Hallo,"

#: nx_lib/views/auth.py:192
msgid "Thanks,<br>The Sydoc Team"
msgstr "Danke,<br>Das Sydoc-Team"

#: nx_lib/views/auth.py:306
msgid "Session expired, please try again"
msgstr "Sitzung abgelaufen, bitte versuchen Sie es erneut"

#: nx_lib/views/auth.py:358
msgid "Database error"
msgstr "Datenbankfehler"

#: nx_lib/views/auth.py:366
msgid "Invalid code. Please try again."
msgstr "Ungültiger Code. Bitte versuchen Sie es erneut."

#: nx_lib/views/auth.py:416
msgid "Invalid code"
msgstr "Ungültiger Code"

#: nx_lib/views/auth.py:431 nx_lib/views/auth.py:772
#: templates/js/_profile_js.html:5
msgid "Passwords do not match"
msgstr "Passwörter stimmen nicht überein"

#: nx_lib/views/auth.py:433 nx_lib/views/auth.py:774
msgid "All Fields must be filled"
msgstr "Alle Felder müssen ausgefüllt werden"

#: nx_lib/views/auth.py:437 nx_lib/views/auth.py:778
#: nx_lib/views/profile.py:193
msgid "New password has to be atleast 8 characters long, with no whitespaces"
msgstr ""
"Das neue Passwort muss mindestens 8 Zeichen lang sein und darf keine "
"Leerzeichen enthalten"

#: nx_lib/views/auth.py:457 nx_lib/views/auth.py:796
msgid "New Password musn't be previously used password"
msgstr "Das neue Passwort darf kein bereits verwendetes Passwort sein"

#: nx_lib/views/auth.py:490 nx_lib/views/auth.py:843
msgid "Something went wrong, please try again"
msgstr "Etwas ist schiefgelaufen, bitte versuchen Sie es erneut"

#: nx_lib/views/auth.py:642 nx_lib/views/auth.py:706
msgid "Invalid credentials"
msgstr "Ungültige Anmeldedaten"

#: nx_lib/views/auth.py:671
#, python-format
msgid "Too many failed attempts. Try again in %(minutes)d minute(s)."
msgstr ""
"Zu viele fehlgeschlagene Versuche. Versuchen Sie es in %(minutes)d "
"Minute(n) erneut."

#: nx_lib/views/auth.py:710
