msgid "Permission deleted successfully"
msgstr "Autorisation supprimée avec succès"

#: nx_lib/views/auth.py:117
msgid "Your nexora account is ready"
msgstr "Votre compte nexora est prêt"

#: nx_lib/views/auth.py:119
msgid ""
"An account has been created for you on nexora. Choose your own password "
"by clicking the button below. You will then be asked to set up two-factor"
" authentication."
msgstr ""
"Un compte a été créé pour vous sur nexora. Choisissez votre propre mot de"
" passe en cliquant sur le bouton ci-dessous. Vous serez ensuite invité à "
"configurer l'authentification à deux facteurs."

#: nx_lib/views/auth.py:123
msgid "This link is valid for 7 days."
msgstr "Ce lien est valable 7 jours."

#: nx_lib/views/auth.py:124
msgid "Set Your Password"
msgstr "Définissez votre mot de passe"

#: nx_lib/views/auth.py:126
msgid "nexora Password Reset Request"
msgstr "nexora Demande de réinitialisation du mot de passe"

#: nx_lib/views/auth.py:128
msgid ""
"We received a request to reset the password for your account. You can "
"reset your password by clicking the button below."
msgstr ""
"Nous avons reçu une demande de réinitialisation du mot de passe de votre "
"compte. Vous pouvez réinitialiser votre mot de passe en cliquant sur le "
"bouton ci-dessous."

#: nx_lib/views/auth.py:132
msgid ""
"If you did not request a password reset, please ignore this email. This "
"link is valid for 15 minutes."
msgstr ""
"Si vous n'avez pas demandé de réinitialisation de mot de passe, veuillez "
"ignorer cet e-mail. Ce lien est valable 15 minutes."

